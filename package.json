{
  "name": "leon-li-portfolio",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prepare:content": "node scripts/prepare-content.mjs",
    "project:new": "node scripts/new-project.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.*",
    "test:authoring": "node scripts/authoring-smoke.mjs",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run prepare:content && npm run check:content && npm test && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check:content": "node scripts/validate-content.mjs"
  },
  "dependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@vitejs/plugin-vue": "6.0.9",
    "playwright": "1.64.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.12"
  }
}
